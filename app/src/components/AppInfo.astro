---
import { GITHUB_REPOSITORY_URL, GITHUB_SHA } from 'astro:env/client'

const labels = {
	en: { lang: 'Selected language:', version: 'Version:', repo: 'GitHub repository:' },
	fr: { lang: 'Langue sélectionnée :', version: 'Version :', repo: 'Dépôt GitHub :' },
} as const

const lang = Astro.currentLocale || 'en'
const t = labels[lang as keyof typeof labels] ?? labels.en
const version = GITHUB_SHA || 'dev'
const repoUrl = GITHUB_REPOSITORY_URL
const repoName = repoUrl?.match(/\.com\/([^/]+\/[^/]+)/)?.[1]
---

<p>{t.lang} <code>{lang}</code>.</p>

<p>{t.version} <code>{version}</code>.</p>

{repoUrl && (
	<p>
		{t.repo}{' '}
		<a href={repoUrl}>{repoName}</a>
	</p>
)}
